{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "devpulse-code-intelligence-api": {
      "root": ".",
      "framework": "express",
      "buildCommand": "npm run build"
    },
    "client": {
      "root": "client",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "devpulse-code-intelligence-api"
      }
    }
  ]
}
